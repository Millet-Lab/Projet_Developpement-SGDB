<UserControl x:Class="RefAniWpf.Vue.PagesAdoptions.AjouterAdoptionVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RefAniWpf.Vue.PagesAdoptions"
             mc:Ignorable="d"
             Background="white"
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel MaxWidth="500" HorizontalAlignment="Left" Margin="20">
        <TextBlock Text="📜 Enregistrer une demande d'adoption" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,5"/>
        <TextBlock Text="Créez un dossier d'adoption pour lier un pensionnaire à sa future famille." FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,25"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.Resources>
                <Style TargetType="Label">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#34495E"/>
                    <Setter Property="Margin" Value="0,0,0,15"/>
                </Style>
                <Style TargetType="ComboBox">
                    <Setter Property="Height" Value="32"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,0,0,15"/>
                </Style>
            </Grid.Resources>

            <Label Grid.Row="0" Grid.Column="0" Content="Animal concerné :"/>
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ListeAnimaux}" SelectedItem="{Binding AnimalSelectionne, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="NomAnimal"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Futur adoptant :"/>
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ListeContacts}" SelectedItem="{Binding ContactSelectionne, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Nom"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Date de demande :"/>
            <DatePicker Grid.Row="2" Grid.Column="1" Height="32" SelectedDate="{Binding DateAdoption}"/>
        </Grid>

        <Button Content="📜 Enregistrer le dossier" Command="{Binding ConfirmerAdoptionCommand}" Width="180" Height="35" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Right" Margin="0,20,0,0"/>
    </StackPanel>
</UserControl>
