<UserControl x:Class="RefAniWpf.Vue.PagesContacts.AjouterContactVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RefAniWpf.Vue.PagesContacts"
             mc:Ignorable="d"
             Background="white"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="500" HorizontalAlignment="Left" Margin="20">
            <TextBlock Text="👤 Ajouter une personne de contact" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBlock Text="Création d'une fiche d'identité (Adoptant, Bénévole, Candidat)." FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,25"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.Resources>
                    <Style TargetType="Label">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#34495E"/>
                        <Setter Property="Margin" Value="0,0,0,15"/>
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,0,15"/>
                        <Setter Property="Padding" Value="5,0"/>
                    </Style>
                </Grid.Resources>

                <Label Grid.Row="0" Grid.Column="0" Content="Nom de famille :"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Prénom :"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Prenom, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Rue et Numéro :"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Rue, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="3" Grid.Column="0" Content="Code Postal (ex: 1234) :"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CodePostal, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="4" Grid.Column="0" Content="Localité :"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Localite}"/>

                <Label Grid.Row="5" Grid.Column="0" Content="Registre National :"/>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding RegistreNat}"/>

                <Label Grid.Row="6" Grid.Column="0" Content="Numéro GSM :"/>
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding GSM}"/>

                <Label Grid.Row="7" Grid.Column="0" Content="Téléphone :"/>
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Telephone}"/>

                <Label Grid.Row="8" Grid.Column="0" Content="Email :"/>
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Email}"/>
            </Grid>

            <Button Content="💾 Enregistrer le contact" Command="{Binding EnregistrerContactCommand}" Width="180" Height="35" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Right" Margin="0,15,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
