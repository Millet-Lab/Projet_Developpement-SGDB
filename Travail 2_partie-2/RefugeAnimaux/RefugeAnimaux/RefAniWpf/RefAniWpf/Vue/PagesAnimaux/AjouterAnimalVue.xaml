<UserControl x:Class="RefAniWpf.Vue.PagesAnimaux.AjouterAnimalVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RefAniWpf.Vue.PagesAnimaux"
             xmlns:modele="clr-namespace:RefAniWpf.Modele"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="800"
             Background="White">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="GenreEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="modele:Genre"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="TypeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="modele:TypeAnimal"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="MotifEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="modele:MotifEntree"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="500" HorizontalAlignment="Left" Margin="20">

            <TextBlock Text="🐾 Enregistrer un nouvel animal" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBlock Text="L'identifiant unique à 11 caractères (yymmdd99999) sera calculé automatiquement." FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,25"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 0 : Nom -->
                    <RowDefinition Height="Auto"/>
                    <!-- 1 : Contact -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2 : Motif -->
                    <RowDefinition Height="Auto"/>
                    <!-- 3 : Sexe -->
                    <RowDefinition Height="Auto"/>
                    <!-- 4 : Espèce -->
                    <RowDefinition Height="Auto"/>
                    <!-- 5 : Couleur -->
                    <RowDefinition Height="Auto"/>
                    <!-- 6 : Naissance -->
                    <RowDefinition Height="Auto"/>
                    <!-- 7 : Stérilisation -->
                    <RowDefinition Height="Auto"/>
                    <!-- 8 : Particularités -->
                    <RowDefinition Height="Auto"/>
                    <!-- 9 : Description -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Nom (Ligne 0) -->
                <Label Grid.Row="0" Grid.Column="0" Content="Nom de l'animal :"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NomAnimal, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Contact (Ligne 1) -->
                <Label Grid.Row="1" Grid.Column="0" Content="Apporté par (Contact) :"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ListeContactsDisponibles}" SelectedItem="{Binding ContactSelectionne}" DisplayMemberPath="Nom"/>

                <!-- Motif d'entrée (Ligne 2) -->
                <Label Grid.Row="2" Grid.Column="0" Content="Motif d'entrée :"/>
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Source={StaticResource MotifEnum}}" SelectedItem="{Binding MotifSelectionne}"/>

                <!-- Sexe (Ligne 3) -->
                <Label Grid.Row="3" Grid.Column="0" Content="Sexe de l'animal :"/>
                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Source={StaticResource GenreEnum}}" SelectedItem="{Binding SexeSelectionne}"/>

                <!-- Espèce (Ligne 4) -->
                <Label Grid.Row="4" Grid.Column="0" Content="Espèce / Type :"/>
                <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Source={StaticResource TypeEnum}}" SelectedItem="{Binding TypeSelectionne}"/>

                <!-- Couleur (Ligne 5) -->
                <Label Grid.Row="5" Grid.Column="0" Content="Couleur(s) :"/>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CouleurSaisie, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Naissance (Ligne 6) -->
                <Label Grid.Row="6" Grid.Column="0" Content="Date de naissance :"/>
                <DatePicker Grid.Row="6" Grid.Column="1" SelectedDate="{Binding DateNaissance}"/>

                <!-- Stérilisation (Ligne 7) -->
                <Label Grid.Row="7" Grid.Column="0" Content="Stérilisation :"/>
                <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,15">
                    <CheckBox Content="L'animal est stérilisé" IsChecked="{Binding IsSterilise, Mode=TwoWay}" Margin="0,0,0,8"/>
                    <DatePicker SelectedDate="{Binding DateSterilisation}" IsEnabled="{Binding IsSterilise}"/>
                </StackPanel>

                <!-- Particularités (Ligne 8) -->
                <Label Grid.Row="8" Grid.Column="0" Content="Particularités :"/>
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Particularites}"/>

                <!-- Description (Ligne 9) -->
                <Label Grid.Row="9" Grid.Column="0" Content="Description globale :"/>
                <TextBox Grid.Row="9" Grid.Column="1" Height="60" AcceptsReturn="True" Text="{Binding Description}"/>
            </Grid>

            <!-- Bouton d'enregistrement (Toujours visible grâce au défilement) -->
            <Button Content="💾 Valider l'admission" Command="{Binding EnregistrerAnimalCommand}" Width="180" Height="35" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Right" Margin="0,20,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
