<UserControl x:Class="RefAniWpf.Vue.PagesAnimaux.ListerAnimauxVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RefAniWpf.Vue.PagesAnimaux"
             mc:Ignorable="d" 
             Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📋 Animaux présents au refuge" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBlock Text="Liste complète des animaux extraite de la base des données." FontSize="12" Foreground="#7F8C8D"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding ListeAnimaux}" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="White" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="32">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Identifiant Unique" Binding="{Binding IdAnimal}" FontWeight="Bold" Width="120"/>
                <DataGridTextColumn Header="Nom" Binding="{Binding NomAnimal}" Width="120"/>
                <DataGridTextColumn Header="Sexe" Binding="{Binding Sexe}" Width="60"/>
                <DataGridTextColumn Header="Espèce" Binding="{Binding Type}" Width="100"/>
                <DataGridTextColumn Header="Date Naissance" Binding="{Binding DateNaissance, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>
                <DataGridCheckBoxColumn Header="Stérilisé" Binding="{Binding Sterilise}" Width="60"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Particularités" Binding="{Binding Particularites}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
