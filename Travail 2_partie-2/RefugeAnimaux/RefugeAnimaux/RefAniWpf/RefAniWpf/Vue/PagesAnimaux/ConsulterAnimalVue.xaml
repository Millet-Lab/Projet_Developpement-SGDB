<UserControl x:Class="RefAniWpf.Vue.PagesAnimaux.ConsulterAnimalVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RefAniWpf.Vue.PagesAnimaux"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="White">
    <UserControl.Resources>
        <!-- Convertisseur simple pour masquer la fiche si FicheComplete est nulle -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="🔍 Consulter la fiche d'un animal" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,5"/>
        <TextBlock Text="Sélectionnez un pensionnaire pour interroger la base des données." FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,20"/>

        <Border Background="#F8F9FA" Padding="15" CornerRadius="5" Margin="0,0,0,25" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Label Content="Sélectionner l'animal :" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="#34495E"/>
                <ComboBox ItemsSource="{Binding ListeAnimauxDisponibles}" 
                          SelectedItem="{Binding AnimalSelectionne, UpdateSourceTrigger=PropertyChanged }" 
                          DisplayMemberPath="NomAnimal" Width="250" Height="32" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Visibility="{Binding EstFicheVisible, FallbackValue=Collapsed}">

            <TextBlock Text="📋 Caractéristiques Spécifiques" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

            <UniformGrid Columns="2" Margin="0,0,0,10">
                <UniformGrid.Resources>
                    <Style TargetType="StackPanel">
                        <Setter Property="Margin" Value="0,0,0,15"/>
                    </Style>
                    <Style TargetType="TextBlock" x:Key="Lbl">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#7F8C8D"/>
                        <Setter Property="Margin" Value="0,0,2,0"/>
                    </Style>
                    <Style TargetType="TextBlock" x:Key="Val">
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Medium"/>
                        <Setter Property="Foreground" Value="#2C3E50"/>
                    </Style>
                </UniformGrid.Resources>

                <StackPanel>
                    <TextBlock Text="Identifiant Unique (11 car.) :" Style="{StaticResource Lbl}"/>
                    <TextBlock Text="{Binding FicheComplete.IdAnimal}" Style="{StaticResource Val}" FontWeight="Bold" Foreground="#2980B9"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Nom du Pensionnaire :" Style="{StaticResource Lbl}"/>
                    <TextBlock Text="{Binding FicheComplete.NomAnimal}" Style="{StaticResource Val}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Sexe :" Style="{StaticResource Lbl}"/>
                    <TextBlock Text="{Binding FicheComplete.Sexe}" Style="{StaticResource Val}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Espèce / Type :" Style="{StaticResource Lbl}"/>
                    <TextBlock Text="{Binding FicheComplete.Type}" Style="{StaticResource Val}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Date de Naissance :" Style="{StaticResource Lbl}"/>
                    <TextBlock Text="{Binding FicheComplete.DateNaissance, StringFormat={}{0:dd/MM/yyyy}}" Style="{StaticResource Val}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Couleur(s) enregistrée(s) :" Style="{StaticResource Lbl}"/>
                    <TextBlock Text="{Binding CouleursAffichees}" Style="{StaticResource Val}" FontStyle="Italic"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Statut Chirurgical :" Style="{StaticResource Lbl}"/>
                    <CheckBox Content="L'animal est stérilisé" IsChecked="{Binding FicheComplete.Sterilise}" IsEnabled="False" VerticalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Date de Stérilisation :" Style="{StaticResource Lbl}"/>
                    <TextBlock Text="{Binding FicheComplete.DateSterilisation, StringFormat={}{0:dd/MM/yyyy}, FallbackValue='Non renseignée'}" Style="{StaticResource Val}"/>
                </StackPanel>
            </UniformGrid>

            <!-- Particularités -->
            <TextBlock Text="⚠️ Particularités comportementales / médicales :" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,10,0,4"/>
            <Border Background="#FFF5F5" BorderBrush="#FEB2B2" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,0,0,15">
                <TextBlock Text="{Binding FicheComplete.Particularites, FallbackValue='Aucune particularité spécifique.'}" TextWrapping="Wrap" Foreground="#C53030" FontWeight="Medium"/>
            </Border>

            <!-- Description -->
            <TextBlock Text="📝 Description générale :" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,4"/>
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" CornerRadius="4">
                <TextBlock Text="{Binding FicheComplete.Description, FallbackValue='Aucune description.'}" TextWrapping="Wrap" Foreground="#334155"/>
            </Border>

        </StackPanel>
    </StackPanel>
</UserControl>
