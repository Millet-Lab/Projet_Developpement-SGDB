<UserControl x:Class="RefAniWpf.Vue.PagesAnimaux.GestionInfosAnimalVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RefAniWpf.Vue.PagesAnimaux"
             mc:Ignorable="d"
             Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📋 Administration des informations des Animaux" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content=" Sélectionner un pensionnaire :" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding ListeAnimaux}" SelectedItem="{Binding AnimalSelectionne, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="NomAnimal" Width="250" Height="32" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Bloc de gauche : Ajout d'informations -->
            <GroupBox Grid.Column="0" Header="➕ Ajouter des détails métiers" Margin="0,0,10,0" Padding="15">
                <StackPanel>
                    <Label Content="Description / Note d'observation :" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding NouvelleDescription, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,5,0,15"/>

                    <Label Content="Particularités / Compatibilités :" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding NouvellesParticularites, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,5,0,20"/>

                    <Button Content="💾 Valider les ajouts" Command="{Binding AjouterInfoCommand}" Background="#2ECC71" Foreground="White" FontWeight="Bold" Height="35" BorderThickness="0"/>
                </StackPanel>
            </GroupBox>

            <!-- Bloc de droite : Purge d'informations -->
            <GroupBox Grid.Column="1" Header="🗑️ Purger / Supprimer les détails" Margin="10,0,0,0" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="⚠️ Attention Action Irréversible" FontSize="14" FontWeight="Bold" Foreground="#D63031" Margin="0,0,0,10"/>
                        <TextBlock Text="Cette action va réinitialiser et effacer définitivement l'ensemble des descriptions, particularités et compatibilités associées à ce pensionnaire dans la BD." TextWrapping="Wrap" Foreground="#7F8C8D" FontSize="13" LineHeight="18"/>
                    </StackPanel>

                    <!-- Bouton connecté directement à SupprimerInfoCommand -->
                    <Button Grid.Row="1" Content="🗑️ Purger la fiche de l'animal" Command="{Binding SupprimerInfoCommand}" Background="#D63031" Foreground="White" FontWeight="Bold" Height="35" BorderThickness="0"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
